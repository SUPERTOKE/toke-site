{
  "name": "shizzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "node scripts/free-dev-port.mjs 3000 && rm -rf node_modules/.vite dist && vercel dev",
    "build": "vite build",
    "process:moonman": "node scripts/knockout-moonman-bg.mjs",
    "process:trade-previews": "node scripts/knockout-edge-transparent.mjs src/assets/trade-previews/toke-coinbase-mobile.png src/assets/trade-previews/toke-coinbase-mobile.png --max=58 --spread=34 && node scripts/knockout-edge-transparent.mjs src/assets/trade-previews/toke-jupiter-mobile.png src/assets/trade-previews/toke-jupiter-mobile.png --max=58 --spread=34",
    "preview": "vite preview",
    "verify:redis": "node scripts/verify-redis-snapshots.mjs",
    "check:stats-api": "node scripts/check-stats-api.mjs",
    "check": "npm run check:dead-code && npm run check:deps && npm run lint && npm run build",
    "check:dead-code": "knip",
    "check:deps": "depcheck --ignores=@vitejs/plugin-vue,sass,sharp,tailwindcss,vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "three": "^0.160.0",
    "vue": "^3.2.47",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.22.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^9.33.0",
    "knip": "^5.45.0",
    "sass": "^1.71.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.2",
    "vite": "^4.3.9"
  }
}
