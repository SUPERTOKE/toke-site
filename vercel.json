{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/toke-stats.js": {
      "maxDuration": 90
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mctoken.xyz"
        }
      ],
      "destination": "https://mctoken.xyz/$1",
      "permanent": true
    }
  ]
}
