# Solana RPC (optional; defaults to public mainnet)
# SOLANA_RPC_URL=

# Canonical Meteora pool on DexScreener / GeckoTerminal (override when the pool migrates)
# TOKE_DEX_PAIR_ADDRESS=Ad6NEGrxHSBAGwfSTtBSHmKQgedHotCJZyFwCgRRAXc9

# Upstash Redis for 24h holder / mcap snapshot metrics (required on Vercel Production)
